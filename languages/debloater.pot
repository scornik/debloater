#: src/Analyze/DontTouchRules.php:318
#, php-format
msgid "This page shows a cart away from the shop: %s. The cart-fragments script is what keeps that total correct, so it is needed on every page; making it conditional would leave a number that never updates."
msgid_plural "These pages show a cart away from the shop: %s. The cart-fragments script is what keeps those totals correct, so it is needed on every page; making it conditional would leave numbers that never update."
msgstr[0] ""
msgstr[1] ""

