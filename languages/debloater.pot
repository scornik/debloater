msgstr[0] ""
msgstr[1] ""

#. translators: %s: comma-separated list of plugin files.
#: src/Analyze/Rules/InactivePluginsRule.php:92
#, php-format
msgid "Installed but not active: %s."
msgstr ""

#: src/Analyze/Rules/InactivePluginsRule.php:95
msgid "A deactivated plugin is not loaded, so it costs nothing on any request. Its files are still on the server, though, and still get security advisories nobody is watching for a plugin that stopped being used. Whether to delete it is a decision only you can make, and it is not one this plugin will make for you."
msgstr ""

#: src/Analyze/Rules/InactivePluginsRule.php:100
msgid "Deactivated plugins"
msgstr ""

#: src/Analyze/Rules/JqueryMigrateRule.php:105
msgid "jQuery Migrate loads alongside jQuery on every page"
msgstr ""

#: src/Analyze/Rules/JqueryMigrateRule.php:114
msgid "The registered jQuery bundle still includes jquery-migrate, so both scripts load wherever jQuery does."
msgstr ""

#: src/Analyze/Rules/JqueryMigrateRule.php:123
msgid "Migrate exists to keep code written for jQuery 1.x working on modern jQuery. A site whose theme and plugins are current does not need it. A site where something still uses the old APIs breaks quietly without it: no error page, just JavaScript that stops running."
msgstr ""

#: src/Analyze/Rules/JqueryMigrateRule.php:132
msgid "jQuery Migrate in the jQuery bundle"
msgstr ""

#: src/Analyze/Rules/NewsWidgetRule.php:97
msgid "The Events and News widget is on the dashboard"
msgstr ""

#: src/Analyze/Rules/NewsWidgetRule.php:98
msgid "The WordPress Events and News widget is registered on the dashboard."
msgstr ""

#: src/Analyze/Rules/NewsWidgetRule.php:99
msgid "This is the one widget on a default dashboard that fetches something over the network while the page is loading — release news and nearby events, from wordpress.org. If you read it, keep it. If you have never read it, it is doing that on every dashboard load for nobody."
msgstr ""

#: src/Analyze/Rules/OrphanMetaRule.php:88
msgid "Metadata is left over from content that no longer exists"
msgstr ""

#. translators: %s: number of orphaned meta rows.
#: src/Analyze/Rules/OrphanMetaRule.php:91
#, php-format
msgid "%s metadata rows belong to a post, term or user that has been deleted."
msgstr ""

#: src/Analyze/Rules/OrphanMetaRule.php:94
msgid "Deleting content does not always delete everything attached to it. Rows left behind are unreachable through WordPress but still in the database, in every backup and every query against those tables. What counts as orphaned here is deliberately narrow: a row is only included when the table WordPress itself looks in has no matching owner."
msgstr ""

#: src/Analyze/Rules/OrphanMetaRule.php:99
msgid "Orphaned post metadata"
