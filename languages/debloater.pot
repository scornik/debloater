msgstr ""

#: src/Analyze/Rules/ElementorAuditRule.php:263
msgid "HTML or custom code widgets, which can contain anything"
msgstr ""

#: src/Analyze/Rules/ElementorAuditRule.php:267
msgid "theme-builder templates, which are documents nothing links to directly"
msgstr ""

#. translators: %s: comma-separated list of things that hide a widget from the count.
#: src/Analyze/Rules/ElementorAuditRule.php:276
#, php-format
msgid "This site also has %s, so treat the \"in use\" figure as a floor rather than a total. That is why this finding is not more confident than it is."
