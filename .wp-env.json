{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": null,
  "plugins": [],
  "mappings": {
    "wp-content/plugins/debloater": "."
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": false,
    "WP_ENVIRONMENT_TYPE": "local"
  },
  "env": {
    "tests": {
      "mappings": {
        "wp-content/plugins/debloater": "."
      },
      "config": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": false
      }
    },
    "development": {
      "plugins": [
        "https://downloads.wordpress.org/plugin/woocommerce.latest-stable.zip",
        "https://downloads.wordpress.org/plugin/elementor.latest-stable.zip",
        "https://downloads.wordpress.org/plugin/contact-form-7.latest-stable.zip",
        "https://downloads.wordpress.org/plugin/seo-by-rank-math.latest-stable.zip",
        "https://downloads.wordpress.org/plugin/litespeed-cache.latest-stable.zip"
      ],
      "themes": [
        "https://downloads.wordpress.org/theme/storefront.latest-stable.zip"
      ]
    }
  }
}
