includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	paths:
		- wp-debloat.php
		- src
		- runtime-handlers
		- mu-loader
	excludePaths:
		analyse:
			- vendor (?)
			- node_modules (?)
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	# These are defined by wp-config.php, by the mu-plugin loader, or not at all.
	# Without this, analysis would reason from the placeholder values in the
	# bootstrap file and report every guard against them as dead code.
	dynamicConstantNames:
		- WPDEBLOAT_DISABLE
		- WPDEBLOAT_LOADER_MODE
		- WP_CLI
	treatPhpDocTypesAsCertain: false
