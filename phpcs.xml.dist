<?xml version="1.0"?>
<ruleset name="WP Debloat">
	<description>Coding standards for WP Debloat.</description>

	<file>wp-debloat.php</file>
	<file>src</file>
	<file>runtime-handlers</file>
	<file>mu-loader</file>
	<file>tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<file>tools/seed-fixture.php</file>
	<exclude-pattern>*/tools/phpunit-9.phar</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<config name="minimum_supported_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra">
		<!-- PSR-4 autoloading is required by composer.json; WordPress file naming
		     does not apply to src/. -->
		<exclude name="WordPress.Files.FileName"/>

		<!-- BUILD-SPEC §17 Phase 0 mandates the contract API fromArray()/toArray().
		     The WordPress method-naming rule would forbid the specified names, and
		     the specification outranks the convention (BUILD-SPEC §21.1). Local
		     variables and properties stay snake_case, which this rule still covers. -->
		<exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>

		<!-- Tweak ids, fact keys and finding categories are lowercase identifiers by
		     design; "wordpress" as a category value is not a misspelling of the
		     product name. -->
		<exclude name="WordPress.WP.CapitalPDangit.MisspelledInText"/>

		<!-- BUILD-SPEC §10 requires tweak parameters to be emitted with var_export
		     into the generated runtime, so var_export is a code-generation tool here,
		     not leftover debugging. -->
		<exclude name="WordPress.PHP.DevelopmentFunctions.error_log_var_export"/>

		<!-- Class-comment file headers are present; the sniff misreads the
		     declare(strict_types) statement that has to precede them. -->
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
	</rule>

	<rule ref="WordPress-VIP-Go">
		<!-- The only file_get_contents calls read registry JSON shipped inside the
		     plugin directory. BUILD-SPEC §13 rule 9 forbids outbound HTTP outright,
		     and a dedicated test asserts no request is made, so the VIP remote-fetch
		     caching advice does not apply. -->
		<exclude name="WordPressVIPMinimum.Performance.FetchingRemoteData.FileGetContentsUnknown"/>
	</rule>

	<rule ref="PHPCompatibilityWP">
		<!-- PHPCompatibility 9.x predates PHP 8.1 enums and reads every enum method
		     body as being outside object context, so $this and self in an enum are
		     reported as errors. Both are valid PHP 8.1. Remove these exclusions when
		     PHPCompatibility ships enum support. -->
		<exclude name="PHPCompatibility.Variables.ForbiddenThisUseContexts.OutsideObjectContext"/>
		<exclude name="PHPCompatibility.FunctionDeclarations.NewParamTypeDeclarations.SelfOutsideClassScopeFound"/>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wpdebloat"/>
				<element value="WPDEBLOAT"/>
				<element value="WPDebloat"/>
			</property>
		</properties>
		<!-- Tests fire core hooks and touch core globals in order to observe them.
		     They are not defining a plugin API. -->
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp-debloat"/>
			</property>
		</properties>
	</rule>

	<!--
		Writing the generated runtime is the one place this plugin touches the
		filesystem, and it is deliberately not done through WP_Filesystem.

		BUILD-SPEC §10 requires an atomic write: a temporary file, a syntax check,
		then rename() over the target. runtime.php is included on every request, so a
		half-written file is a white screen for the whole site, and WP_Filesystem
		offers no atomic rename — its put_contents() writes in place. The same
		applies to the mu-plugin loader.

		Error suppression in these two classes is likewise load-bearing rather than
		lazy: RuntimeLoader::install() must be able to discover that mu-plugins is
		not writable and fall back (docs/DECISIONS.md D-0007), and a warning printed
		during activation would be both useless to the user and, on some hosts, fatal
		to the redirect that follows.

		Every path is checked against wp-content/wpdebloat after resolution
		(BUILD-SPEC §13 rule 6), which is asserted by an integration test.

		Snapshot\SpillFile is the third: BUILD-SPEC §4 puts Level B recovery points
		above eight megabytes in wp-content/wpdebloat/backups as gzipped files, and
		WP_Filesystem has no streaming or gzip interface at all — reading such a
		snapshot through it would mean holding the whole thing in memory to restore
		it, on a site that has just had something go wrong. Its paths are resolved
		and checked against the backups directory before any read or delete, and its
		one silenced call is a gzgets() over a file that may legitimately be damaged.
	-->
	<rule ref="WordPressVIPMinimum.Functions.RestrictedFunctions">
		<exclude-pattern>src/Apply/RuntimeWriter\.php</exclude-pattern>
		<exclude-pattern>src/Apply/RuntimeLoader\.php</exclude-pattern>
		<exclude-pattern>src/Snapshot/SpillFile\.php</exclude-pattern>
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.NoSilencedErrors">
		<exclude-pattern>src/Apply/RuntimeWriter\.php</exclude-pattern>
		<exclude-pattern>src/Apply/RuntimeLoader\.php</exclude-pattern>
		<exclude-pattern>src/Snapshot/SpillFile\.php</exclude-pattern>
	</rule>
	<!-- proc_open runs `php -l` over the generated runtime before it is put in
	     place. It is guarded by function_exists and a disable_functions check, and
	     its absence downgrades the check rather than failing the write. -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.system_calls_proc_open">
		<exclude-pattern>src/Apply/RuntimeWriter\.php</exclude-pattern>
	</rule>

	<!-- Contracts must work with no WordPress loaded: the whole unit suite runs
	     without it, and Contracts\Json is what hashes the registry and the runtime.
	     wp_json_encode is not available in that context. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>src/Contracts/Json\.php</exclude-pattern>
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<!-- Unit tests run without WordPress loaded (tests/bootstrap-unit.php), so the
	     WordPress wrappers these rules prefer do not exist there. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPressVIPMinimum.Performance.FetchingRemoteData">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.PreparedSQL">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
<!--
		tools/seed-fixture.php deliberately creates messy data — spam, orphaned
		meta, sub-minute cron, a half-megabyte autoloaded option — so that the
		development site has something for the dashboard to find. It is a
		top-level script, so every local is a "global" to the prefix sniff, and it
		refuses to run unless WP_ENVIRONMENT_TYPE is local.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>tools/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>tools/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>tools/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.SlowDBQuery">
		<exclude-pattern>tools/*</exclude-pattern>
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.CronInterval">
		<exclude-pattern>tools/*</exclude-pattern>
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
