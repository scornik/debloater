{
    "name": "scornik/debloater",
    "description": "Debloater — evidence-based WordPress configuration auditing and safe, reversible debloating.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "automattic/vipwpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/wordpress-stubs": "^6.5",
        "php-stubs/wp-cli-stubs": "^2.10",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Debloater\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Debloater\\Tests\\Unit\\": "tests/Unit/",
            "Debloater\\Tests\\Integration\\": "tests/Integration/",
            "Debloater\\Tests\\FailProbe\\": "tests/FailProbe/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "test:unit": "phpunit --configuration phpunit.xml.dist --testsuite unit",
        "lint": "phpcs --standard=phpcs.xml.dist",
        "lint:fix": "phpcbf --standard=phpcs.xml.dist",
        "analyze": "phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "check": [
            "@lint",
            "@analyze",
            "@test"
        ],
        "check:packaging": "node tools/packaging-check.mjs"
    },
    "scripts-descriptions": {
        "check": "Lint, static analysis and the unit suite.",
        "check:packaging": "Build the release archive with a production autoloader and run tests/Packaging, then restore the development autoloader. Deliberately not part of `check`: it rebuilds the admin UI and takes a minute or two."
    }
}
